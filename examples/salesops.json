  "pivots": {
    "territory_plan": {
      "name": "Territory plan",
      "dims": {
        "territory": "territories"
      },
      "lines": [
        {
          "id": "account_count",
          "name": "Accounts"
        },
        {
          "id": "employees_covered",
          "name": "Employees covered"
        },
        {
          "id": "activity_points",
          "name": "Activity points"
        },
        {
          "id": "booked",
          "name": "Bookings"
        },
        {
          "id": "quota"
        },
        {
          "id": "attainment",
          "format": "percent"
        }
      ],
      "rules": [
        "account_count    = COUNT(accounts.employees[territory=@territory])",
        "employees_covered = SUM(accounts.employees[territory=@territory])",
        "activity_points  = SUM(activities.score[account.territory=@territory])",
        "booked           = SUM(bookings.acv[rep.territory=@territory])",
        "quota            = SUM(reps.quota[territory=@territory]) / 4",
        "attainment       = IFERROR(booked / quota, 0)"
      ]
    },
    "commissions": {
      "name": "Commissions (full year)",
      "dims": {
        "rep": "reps",
        "tranche": "tranches",
        "period": false
      },
      "lines": [
        {
          "id": "attainment",
          "format": "percent"
        },
        {
          "id": "in_tranche",
          "name": "Attainment in tranche",
          "format": "percent"
        },
        {
          "id": "commission"
        }
      ],
      "rules": [
        "attainment                = SUM(bookings.acv) / rep.quota",
        "in_tranche                = IF(attainment <= tranche.from_pct, 0, IF(attainment >= tranche.to_pct, tranche.to_pct - tranche.from_pct, attainment - tranche.from_pct))",
        "commission                = in_tranche * rep.quota * tranche.rate",
        "in_tranche[tranche=total] = SUM(in_tranche[tranche != total])",
        "commission[tranche=total] = SUM(commission[tranche != total])"
      ]
    }
  },
  "outputs": [
    {
      "pivot": "territory_plan",
      "rows": [
        "territory",
        "line"
      ],
      "cols": [
        "period"
      ],
      "title": "Territory plan by quarter"
    },
    {
      "pivot": "commissions",
      "rows": [
        "rep",
        "tranche"
      ],
      "cols": [
        "line"
      ],
      "title": "Commissions",
      "decimals": 0
    }
  ],
