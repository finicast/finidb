      "rules": [
        "ev = deal.ev",
        "revenue = deal.target_revenue",
        "ebitda = deal.target_ebitda",
        "ebitda_margin = ebitda / revenue",
        "ev_revenue = ev / revenue",
        "ev_ebitda = ev / ebitda",
        "premium_1d = deal.premium_1d",
        "premium_30d = deal.premium_30d"
      ]
    },
    "summary": {
      "name": "Summary statistics",
      "lineTable": "multiples_lines",
      "dims": {
        "stat": "stats"
      },
      "rules": [
        "value[stat=low] = MIN(multiples.value)",
        "value[stat=mean] = AVG(multiples.value)",
        "value[stat=median] = MEDIAN(multiples.value)",
        "value[stat=high] = MAX(multiples.value)",
        "value[stat=median_strategic] = MEDIAN(multiples.value[deal.type=strategic])",
        "value[stat=median_sponsor] = MEDIAN(multiples.value[deal.type=sponsor])",
        "value[stat=median_recent] = MEDIAN(multiples.value[deal.year >= 2025])"
      ]
    },
    "implied": {
      "name": "Implied valuation of Helix",
      "dims": {
        "stat": "stats"
      },
      "lines": [
        {
          "id": "ev_from_revenue",
          "name": "Implied EV at EV / Revenue"
        },
        {
          "id": "ev_from_ebitda",
          "name": "Implied EV at EV / EBITDA"
        },
        {
          "id": "equity_from_revenue",
          "name": "Implied equity value at EV / Revenue"
        },
        {
          "id": "equity_from_ebitda",
          "name": "Implied equity value at EV / EBITDA"
        },
        {
          "id": "price_from_revenue",
          "name": "Implied price at EV / Revenue ($)"
        },
        {
          "id": "price_from_ebitda",
          "name": "Implied price at EV / EBITDA ($)"
        },
        {
          "id": "price_from_premium",
          "name": "Implied price at 1-day premium ($)"
        },
        {
          "id": "price_from_premium_30d",
          "name": "Implied price at 30-day premium ($)"
        },
        {
          "id": "current_price",
          "name": "Current price ($)"
        },
        {
          "id": "premium_from_revenue",
          "name": "Implied premium: EV / Revenue",
          "format": "percent"
        },
        {
          "id": "premium_from_ebitda",
          "name": "Implied premium: EV / EBITDA",
          "format": "percent"
        }
      ],
      "rules": [
        "ev_from_revenue = summary.value[line=ev_revenue] * subject.revenue",
        "ev_from_ebitda = summary.value[line=ev_ebitda] * subject.ebitda",
        "equity_from_revenue = ev_from_revenue - subject.net_debt",
        "equity_from_ebitda = ev_from_ebitda - subject.net_debt",
        "price_from_revenue = equity_from_revenue / subject.shares",
        "price_from_ebitda = equity_from_ebitda / subject.shares",
        "price_from_premium = subject.price * (1 + summary.value[line=premium_1d])",
        "price_from_premium_30d = subject.price * (1 + summary.value[line=premium_30d])",
        "current_price = subject.price",
        "premium_from_revenue = price_from_revenue / current_price - 1",
        "premium_from_ebitda = price_from_ebitda / current_price - 1"
      ]
    }
  },
