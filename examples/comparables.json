{
  "model": "comps",
  "name": "Comparable companies analysis",
  "units": "USD millions",
  "tables": {
    "companies": {
      "name": "Companies",
      "fields": {
        "name": "text",
        "kind": "text",
        "sector": "text",
        "ev": "number",
        "revenue": "number",
        "revenue_ny": "number",
        "ebitda": "number",
        "net_income": "number",
        "market_cap": "number",
        "net_debt": "number",
        "shares": "number"
      },
      "rows": [
        {
          "id": "subject",
          "name": "Subject Co",
          "kind": "subject",
          "sector": "software",
          "ev": 0,
          "revenue": 820,
          "revenue_ny": 1010,
          "ebitda": 246,
          "net_income": 130,
          "market_cap": 0,
          "net_debt": 0,
          "shares": 75
        },
        {
          "id": "alpha",
          "name": "AlphaSoft",
          "kind": "peer",
