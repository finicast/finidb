    "comps": {
      "name": "Trading multiples",
      "dims": {
        "company": "companies",
        "basis": "basis"
      },
      "lines": [
        {
          "id": "market_cap",
          "name": "Market cap"
        },
        {
          "id": "net_debt",
          "name": "Net debt (cash)"
        },
        {
          "id": "ev",
          "name": "Enterprise value"
        },
        {
          "id": "ev_revenue",
          "name": "EV / Revenue (x)"
        },
        {
          "id": "ev_ebitda",
          "name": "EV / EBITDA (x)"
        },
        {
          "id": "pe",
          "name": "P / E (x)"
        },
        {
          "id": "rev_growth",
          "name": "Revenue growth",
          "format": "percent"
        },
        {
          "id": "ebitda_margin",
          "name": "EBITDA margin",
          "format": "percent"
        },
        {
          "id": "net_margin",
          "name": "Net margin",
          "format": "percent"
        }
      ],
      "rules": [
        "market_cap    = market_data.price * market_data.shares",
        "net_debt      = market_data.debt - market_data.cash",
        "ev            = market_cap + net_debt",
        "ev_revenue    = ev / financials.revenue",
        "ev_ebitda     = ev / financials.ebitda",
        "pe            = market_data.price / financials.eps",
        "rev_growth[basis=ltm] = financials.revenue[basis=ltm] / financials.revenue_prior[basis=ltm] - 1",
        "rev_growth[basis=ntm] = financials.revenue[basis=ntm] / financials.revenue[basis=ltm] - 1",
        "ebitda_margin = financials.ebitda / financials.revenue",
        "net_margin    = financials.net_income / financials.revenue"
      ]
    },
    "peer_stats": {
      "name": "Peer statistics",
      "lineTable": "comps_lines",
      "dims": {
        "stat": "stats",
        "basis": "basis"
      },
      "rules": [
        "value[stat=low]             = MIN(comps.value[company.peer=1])",
        "value[stat=mean]            = AVG(comps.value[company.peer=1])",
        "value[stat=median]          = MEDIAN(comps.value[company.peer=1])",
        "value[stat=high]            = MAX(comps.value[company.peer=1])",
        "value[stat=median_platform] = MEDIAN(comps.value[company.group=platform])",
        "value[stat=median_hardware] = MEDIAN(comps.value[company.group=hardware])"
      ]
    },
    "implied": {
      "name": "Implied Apple valuation",
      "dims": {
        "stat": "stats",
        "basis": "basis"
      },
      "lines": [
        {
          "id": "ev_from_revenue",
          "name": "Implied EV at peer EV/Revenue"
        },
        {
          "id": "ev_from_ebitda",
          "name": "Implied EV at peer EV/EBITDA"
        },
        {
          "id": "price_from_revenue",
          "name": "Implied price: EV/Revenue ($)"
        },
        {
          "id": "price_from_ebitda",
          "name": "Implied price: EV/EBITDA ($)"
        },
        {
          "id": "price_from_pe",
          "name": "Implied price: P/E ($)"
        },
        {
          "id": "current_price",
          "name": "Current Apple price ($)"
        },
        {
          "id": "upside_revenue",
          "name": "Implied vs current: EV/Revenue",
          "format": "percent"
        },
        {
          "id": "upside_ebitda",
          "name": "Implied vs current: EV/EBITDA",
          "format": "percent"
        },
        {
          "id": "upside_pe",
          "name": "Implied vs current: P/E",
          "format": "percent"
        }
      ],
      "rules": [
        "ev_from_revenue    = peer_stats.value[line=ev_revenue] * financials.revenue[company=aapl]",
        "ev_from_ebitda     = peer_stats.value[line=ev_ebitda] * financials.ebitda[company=aapl]",
        "price_from_revenue = (ev_from_revenue - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_from_ebitda  = (ev_from_ebitda - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_from_pe      = peer_stats.value[line=pe] * financials.eps[company=aapl]",
        "current_price      = market_data.price[company=aapl]",
        "upside_revenue     = price_from_revenue / current_price - 1",
        "upside_ebitda      = price_from_ebitda / current_price - 1",
        "upside_pe          = price_from_pe / current_price - 1"
      ]
    }
  },
