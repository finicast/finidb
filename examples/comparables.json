        "price_ev_revenue_ltm = (peer_stats.value[line=ev_revenue_ltm] * comps.revenue_ltm[company=aapl] - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_ev_revenue_ntm = (peer_stats.value[line=ev_revenue_ntm] * comps.revenue_ntm[company=aapl] - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_ev_ebitda_ltm = (peer_stats.value[line=ev_ebitda_ltm] * comps.ebitda_ltm[company=aapl] - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_ev_ebitda_ntm = (peer_stats.value[line=ev_ebitda_ntm] * comps.ebitda_ntm[company=aapl] - comps.net_debt[company=aapl]) / market_data.shares[company=aapl]",
        "price_pe_ltm = peer_stats.value[line=pe_ltm] * comps.eps_ltm[company=aapl]",
        "price_pe_ntm = peer_stats.value[line=pe_ntm] * comps.eps_ntm[company=aapl]",
        "current_price = market_data.price[company=aapl]",
        "upside_ev_revenue_ltm = price_ev_revenue_ltm / current_price - 1",
        "upside_ev_revenue_ntm = price_ev_revenue_ntm / current_price - 1",
        "upside_ev_ebitda_ltm = price_ev_ebitda_ltm / current_price - 1",
        "upside_ev_ebitda_ntm = price_ev_ebitda_ntm / current_price - 1",
        "upside_pe_ltm = price_pe_ltm / current_price - 1",
        "upside_pe_ntm = price_pe_ntm / current_price - 1"
      ]
    }
  },
